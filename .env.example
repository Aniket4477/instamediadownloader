# Example Environment Variables (Copy to .env.local and populate with your own values)
# DO NOT commit real secrets or production keys to this file.

# GramScraper API Token (for fast Instagram post, carousel, and story extraction)
GRAMSCRAPER_KEY=your_gramscraper_api_key_here

# SocialCrawl API Token (for fast Instagram story extraction)
SOCIALCRAWL_KEY=your_socialcrawl_api_key_here

# Optional: Apify API Token
APIFY_TOKEN=your_apify_token_here

# Allowed CORS Origins (comma-separated for multiple domains)
ALLOWED_ORIGINS=https://instamediadownloader.vercel.app

# Port for local development
PORT=3000
