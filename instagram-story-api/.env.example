# Server Port
PORT=4000
NODE_ENV=development

# Provider Settings
ENABLE_SAVECLIP=true
SAVECLIP_BASE_URL=https://saveclip.app
SAVECLIP_TIMEOUT_MS=12000

ENABLE_INSTASAVER=true
INSTASAVER_BASE_URL=https://instasaver.io
INSTASAVER_TIMEOUT_MS=12000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# In-Memory Cache
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500
